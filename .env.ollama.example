# Shannon + Ollama Configuration
#
# How it works:
#   Ollama must be installed and running on your machine: https://ollama.com/download
#   Set ANTHROPIC_AUTH_TOKEN=ollama and ANTHROPIC_BASE_URL pointing to your Ollama server.
#   Shannon uses glm-5:cloud by default — log in to ollama.com first: ollama login


ANTHROPIC_AUTH_TOKEN=ollama
ANTHROPIC_BASE_URL=http://localhost:11434


# ============================================
# ADDITIONAL SETTINGS
# ============================================

# Reduce context window for smaller/faster models (optional):
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=32000

# Output directory (optional)
# OUTPUT_PATH=./custom-audit-logs

# Pipeline testing mode (optional)
# PIPELINE_TESTING_MODE=true
